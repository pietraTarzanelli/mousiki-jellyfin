{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "cat *": "allow",
      "echo *": "allow",
      "jq *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "diff *": "allow",
      "printf *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}